# Copy to .env and set local secrets. Never commit .env.
# scripts/bootstrap.sh or scripts/bootstrap.ps1 creates .env with a random password if missing.
POSTGRES_PASSWORD=replace-with-a-long-random-value

# Web UI binding (loopback by default; do not expose publicly without TLS and an access policy).
TS_BIND_ADDRESS=127.0.0.1
TS_WEB_PORT=8088

# Set to true only when served over HTTPS.
TS_COOKIE_SECURE=false

# Optional local models (Local mode). Default points at a host Ollama.
# With the compose "local-model" profile use http://ollama:11434 instead.
TS_OLLAMA_BASE_URL=http://host.docker.internal:11434
TS_OLLAMA_MODEL=qwen2.5:3b
TS_OLLAMA_EMBED_MODEL=nomic-embed-text

TS_LOG_LEVEL=INFO
# Delay between simulated hours when replaying an approved plan (milliseconds).
TS_SIM_STEP_DELAY_MS=350
